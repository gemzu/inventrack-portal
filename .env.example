# Inventrack Portal — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel (Project → Settings → Environment Variables) for production.

# Supabase project URL (Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anon key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key — SERVER-ONLY secret. Used by the /api/delete-account route
# to hard-delete auth users (Apple account-deletion compliance). Never prefix with NEXT_PUBLIC_.
# Get it from Supabase dashboard → Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
